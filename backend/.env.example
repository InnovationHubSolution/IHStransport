# Database Configuration — PostgreSQL (remote server)
# First time: npm run migrate:pg (from backend)
DB_TYPE=pg
DB_HOST=172.16.0.68
DB_PORT=5432
DB_NAME=bus_cashless
DB_USER=bus_user
DB_PASSWORD=bus_password123

# --- Or SQLite (file-based) ---
# DB_TYPE=sqlite
# DB_PATH=./data/development.sqlite

# Server Configuration
PORT=3001
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here

# M-Vatu merchant settings
# Vodafone Vanuatu has not published a merchant HTTP API.
# Leave these blank until Vodafone supplies a base URL, credentials, and merchant code.
# Legacy MYCASH_* names are still read if MVATU_* is empty. Do not point them at Digicel.
MVATU_API_URL=
MVATU_API_KEY=
MVATU_USERNAME=
MVATU_PASSWORD=
MVATU_MERCHANT_MOBILE=
MVATU_MERCHANT_CODE=

# Redis Configuration (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379
